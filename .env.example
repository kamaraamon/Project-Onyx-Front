# Configuration d'exemple pour Onyx
# Dupliquer ce fichier en '.env' et remplacer par vos vraies informations

# Base de données PostgreSQL (ex: Neon Cloud)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Clé de chiffrement AES-256 (32 octets / 64 caractères hexadécimaux ou phrase secrète)
ENCRYPTION_KEY="remplacer_par_votre_cle_secrete_de_chiffrement"

# Port du serveur (optionnel)
PORT=5000
